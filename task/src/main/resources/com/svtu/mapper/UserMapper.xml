<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.svtu.mapper.UserMapper">
    <update id="updateUser">
        update t_user
        <set>
            update_datetime=now(),
            <if test="user.username!=null and user.username!=''">
                username=#{user.username},
            </if>
            <if test="user.sex!=null and user.sex!=''">
                sex=#{user.sex},
            </if>
            <if test="user.age!=null and user.age!=0">
                age=#{user.age},
            </if>
            <if test="user.address!=null and user.address!=''">
                address=#{user.address},
            </if>
            <if test="user.imagePath!=null and user.imagePath!=''">
                image_path=#{user.imagePath},
            </if>
            <if test="user.nickname!=null and user.nickname!=''">
                nickname=#{user.nickname},
            </if>
        </set>
        where user_id=#{user.userId}
    </update>
    <update id="updatePhone">
        update t_user set phone=#{phone} where user_id=#{userId}
    </update>

    <select id="selectByUsernameUser" resultType="com.svtu.VO.UserVO">
        select * from t_user where username=#{username}
    </select>
    <select id="selectByUserId" resultType="com.svtu.VO.UserVO">
        select * from t_user where user_id=#{userId}
    </select>
    <select id="selectUserId" resultType="com.svtu.entity.User">
        select * from t_user where username=#{username}
    </select>
</mapper>